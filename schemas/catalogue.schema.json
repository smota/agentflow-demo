{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/smota/agentflow-demo/main/schemas/catalogue.schema.json",
  "title": "AwesomeAwesomeness catalogue.json",
  "description": "Committed, digest-verified snapshot of the three-source CC0 preview catalogue (aggregated resource entries across curated lists), validated at runtime by awesome/catalogue.py::validate_catalogue. This schema documents the data *shape*; cross-field integrity rules enforced only in code (digest recomputation, per-resource id derivation from its URL, license-text digest matching) are noted in descriptions but not re-derived here — see docs/data-schema-changelog.md.",
  "type": "object",
  "required": [
    "format_version",
    "generated_at",
    "discovery",
    "candidates",
    "coverage",
    "sources",
    "resources",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "description": "Runtime compatibility gate read by awesome/catalogue.py. Distinct from the data-shape semver policy in docs/data-schema-changelog.md."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "discovery": {
      "type": "array",
      "description": "One entry per discovery search query executed against GitHub.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "observed_at", "total_count", "received", "pages", "incomplete_results"],
        "properties": {
          "query": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "total_count": { "type": "integer", "minimum": 0 },
          "received": { "type": "integer", "minimum": 0 },
          "pages": { "type": "integer", "minimum": 0 },
          "incomplete_results": { "type": "boolean" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "Every repository observed during discovery, selected or excluded from the reviewed three-source preview.",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "coverage": {
      "type": "string",
      "description": "Human-readable coverage/scope statement, e.g. 'Three reviewed CC0 lists; primary Markdown list-item links only. Not exhaustive.'"
    },
    "sources": {
      "type": "array",
      "description": "The reviewed, qualifying (decision: selected) source lists whose content was extracted into resources[].occurrences[]. A strict superset-selection of candidates[] filtered to decision == 'selected'.",
      "items": { "$ref": "#/$defs/source" }
    },
    "resources": {
      "type": "array",
      "description": "Deduplicated resource entries aggregated across all sources[], keyed by a sha256-derived id over the canonical URL.",
      "items": { "$ref": "#/$defs/resource" }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 of the canonical JSON serialization of every other top-level field (see awesome/catalogue.py::digest); not re-derived by this schema."
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "stars", "public", "observed_at", "default_branch",
        "queries", "detected_license", "is_resource_list", "decision", "reason"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[^/]+/[^/]+$", "description": "owner/repo." },
        "stars": { "type": "integer", "minimum": 0 },
        "public": { "type": "boolean" },
        "observed_at": { "type": "string", "format": "date-time" },
        "default_branch": { "type": "string" },
        "queries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "detected_license": { "type": ["string", "null"] },
        "is_resource_list": { "type": "boolean" },
        "decision": { "enum": ["selected", "excluded"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "A candidate promoted to decision: selected. Must satisfy qualifies() (stars >= 100, public, is_resource_list) and license == 'CC0-1.0' (awesome/catalogue.py::validate_catalogue).",
      "required": [
        "id", "stars", "public", "observed_at", "default_branch", "queries",
        "detected_license", "is_resource_list", "decision", "reason",
        "revision", "extracted_at", "readme_path", "readme_sha256",
        "license", "license_path", "license_text", "license_sha256",
        "extracted_occurrences"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "stars": { "type": "integer", "minimum": 100 },
        "public": { "const": true },
        "observed_at": { "type": "string", "format": "date-time" },
        "default_branch": { "type": "string" },
        "queries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "detected_license": { "type": "string" },
        "is_resource_list": { "const": true },
        "decision": { "const": "selected" },
        "reason": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "extracted_at": { "type": "string", "format": "date-time" },
        "readme_path": { "type": "string", "minLength": 1 },
        "readme_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "const": "CC0-1.0" },
        "license_path": { "type": "string", "minLength": 1 },
        "license_text": { "type": "string", "minLength": 1 },
        "license_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 of license_text; must match (enforced in code, not by this schema)."
        },
        "extracted_occurrences": { "type": "integer", "minimum": 0 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "description", "occurrences"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{20}$",
          "description": "First 20 hex chars of sha256(url); must match the canonicalized url (enforced in code)."
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "description": "Every source occurrence this resource was extracted from; unattributed resources (empty array) are rejected in code.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "line", "title", "description", "category"],
            "properties": {
              "source": { "type": "string", "description": "Must match a sources[].id (enforced in code)." },
              "line": { "type": "integer", "minimum": 1 },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
