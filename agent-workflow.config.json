{
  "ciCommands": ["npm run check:workflow", "python -m pytest -q --basetemp=.cache/pytest", "python -m tools.crawl validate"],
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "development",
    "directEditDeniedBranches": ["main", "development"],
    "defaultPrTarget": "development",
    "promotionOrder": ["development", "main"],
    "workBranchPrefixes": ["work/", "feature/", "fix/", "hotfix/", "spike/", "codex/"],
    "compatibilityBranchPrefixes": [],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "development",
    "trunkBranch": "main",
    "referenceKeywords": ["Implements", "Closes"],
    "addLabels": ["integrated:development", "awaiting-release"],
    "closeIntegratedIssues": true
  },
  "releaseVersioning": {
    "strategy": "main.minor.fix",
    "segments": ["main", "minor", "fix"],
    "tagFormat": "v${version}",
    "packageVersionSource": "package.json",
    "requireExplicitApproval": true,
    "allowPrerelease": true
  },
  "routing": {"defaultMode": "single-agent", "agents": {}, "roles": {}},
  "delivery": {
    "source": {
      "kind": "github",
      "repo": "smota/agentflow-demo",
      "branch": "agentflow-state"
    },
    "candidate": {
      "inputs": [
        "docs/demo/evidence/recovery-contract.json",
        "tests/test_recovery_contract.mjs",
        "requirements.txt"
      ]
    },
    "checks": {
      "recovery-contract": {
        "id": "recovery-contract",
        "criterionId": "recovery-contract",
        "executable": "node",
        "args": ["--test", "--test-reporter=junit", "tests/test_recovery_contract.mjs"],
        "assertions": [
          "recovery contract fences writers and stale plans",
          "publication and fresh-context boundaries are explicit",
          "release evidence keeps independent observations"
        ],
        "timeoutMs": 30000,
        "format": "junit-stdout"
      }
    },
    "contracts": {
      "product-manager": "agentflow/delivery/issue-24-product-manager.json"
    }
  },
  "capabilities": {
    "plan-before-edit": {"requiredFor": ["architect", "developer-planning", "developer"], "fallback": "framework-emulated"},
    "workflow-orchestration": {"preferred": "framework", "allowNative": true},
    "bounded-loop": {"allowedLoops": ["review-loop", "test-fix-loop"], "maxIterationsDefault": 3, "requiresStopCondition": true},
    "delegated-subagents": {"default": "optional", "maxParallel": 3, "readOnlyByDefault": true, "singleWriterRule": true, "executionTargets": {"codex-cli": "native"}}
  }
}
